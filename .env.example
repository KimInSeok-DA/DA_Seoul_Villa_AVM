# predict.py는 키 없이도 돈다. 키가 있으면 수집 데이터에 없는 지번을 실행 중에 조회한다(docs/의사결정/1007_12)

# 공공데이터포털(data.go.kr) 인증키 — 실거래가 수집, 건축HUB 건축물대장(수집·실행 중 조회)
DATA_GO_KR_API_KEY=

# VWorld 인증키 — 공동주택 공시가격(수집·실행 중 조회), 연속지적도(필지 좌표·공시지가 수집)
VWORLD_API_KEY=

# 선택: Kakao REST API 키 — 응답 확인용(src/probe_apis.py)만. 결과 저장 금지라 수집·예측에 쓰지 않음
KAKAO_REST_API_KEY=

# 선택: 서울 열린데이터광장 인증키 — 폐쇄말소대장 표제부(철거된 건물 확인) 수집용(src/collect_closed_titles.py)만. predict.py는 쓰지 않음
SEOUL_OPEN_API_KEY=

# 선택: 한국부동산원 R-ONE Open API 인증키 — 연립/다세대 매매 지수(시점 지수 검증용, src/collect_reb_index.py)만. predict.py는 쓰지 않음
REB_API_KEY=
